{
  "version": 2,
  "builds": [
    {
      "src": "central-negocio-old/backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["central-negocio-old/frontend/**"]
      }
    },
    {
      "src": "landing/api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "painel\\.fantonisoftware\\.com\\.br" }],
      "dest": "/central-negocio-old/backend/src/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/landing/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/landing/$1"
    }
  ]
}
