{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "central-negocio-old/backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "central-negocio-old/frontend/**"
        ]
      }
    },
    {
      "src": "landing/api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "landing/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "painel\\.fantonisoftware\\.com\\.br"
        }
      ],
      "dest": "/central-negocio-old/backend/src/server.js"
    },
    {
      "src": "/index.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/landing/api/$1.js"
    },
    {
      "src": "/((?!central-negocio-old/|landing/).*)",
      "dest": "/landing/$1"
    }
  ]
}
