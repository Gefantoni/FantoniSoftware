String.prototype.digits = function () {
    return this.replace(/\D/g, '').trim()
}

$(() => {
    let $masks = [
        {
            key: 'cnpj',
            mask: '99.999.999/9999-99',
        },
        {
            key: 'cpf',
            mask: '999.999.999-99',
        },
        {
            key: 'cpf_cnpj',
            mask: '00.000.000/0000-00',
            onKeyPress: (v, e, f, o) => {
                let l = v.digits().length
                f.mask((l >= 1 && l <= 11) ? '000.000.000-00#' : '00.000.000/0000-00', o);
            }
        },
        {
            key: 'phone',
            mask: '(99) 999999990'
        },
        {
            key: 'date',
            mask: '99/99/9999',
        },
        {
            key: 'cep',
            mask: '99999-999'
        },
        {
            key: 'expire-card',
            mask: '99/99',
        },
        {
            key: 'one',
            mask: '9'
        }
    ]

    $('[mask]').each((i, e) => {
        let f = $(e)

        if (f.attr('mask').substring(0, 7) === 'custom:')
            f.mask(f.attr('mask').replace('custom:', '').trim())
        else
            for (let m of $masks)
                if (m.key === f.attr('mask')) f.mask(m.mask, {onKeyPress: m.onKeyPress})
    })
})

const isCnpjValid = (v) => {
    v = v.digits()

    if (v.length !== 14) return false
    let result = true

    let c = v.substring(0, 12)
    let dv = v.substring(12, 14)
    let d1 = 0
    for (let i = 0; i < 12; i++) d1 += c.charAt(11 - i) * (2 + (i % 8))
    if (d1 === 0) result = false
    d1 = 11 - (d1 % 11)
    if (d1 > 9) d1 = 0
    if (dv.charAt(0) !== d1.toString()) result = false
    d1 *= 2
    for (let i = 0; i < 12; i++) d1 += c.charAt(11 - i) * (2 + ((i + 1) % 8))
    d1 = 11 - (d1 % 11)
    if (d1 > 9) d1 = 0
    if (dv.charAt(1) !== d1.toString()) result = false

    return result
}

const isCpfValid = (v) => {
    return v.digits().length === 11
}

const isDateValid = (v) => {
    v = v.digits()

    if (v.length !== 8) return false
    let d = parseInt(v.substring(0, 2))
    if (d < 1 || d > 31) return false
    let m = parseInt(v.substring(2, 4))
    if (m < 1 || m > 12) return false

    return parseInt(v.substring(4, 8)) >= 1900
}

const isExpireCardValid = (v) => {
    v = v.digits()

    if (v.length !== 4) return false

    let m = parseInt(v.substring(0, 2));
    if (m < 1 || m > 12) return false

    let y = parseInt(v.substring(2, 4));
    let dy = new Date().getFullYear()

    return parseInt(dy.toString().substring(0, 2) + y) >= dy
}
